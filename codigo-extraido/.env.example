# Optional: enable real Google OAuth sign-in for Pokemon Battle Royale.
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud Console.
# Add this exact callback URL to Authorized redirect URIs:
# http://127.0.0.1:3210/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3210/api/auth/google/callback
