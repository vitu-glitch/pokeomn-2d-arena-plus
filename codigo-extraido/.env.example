# Optional: enables the real Google OAuth button in Pokemon Battle Royale.
# Copy this file to .env (never commit .env) and fill in the credentials from Google Cloud.
# Setup guide: GOOGLE_AUTH_SETUP.md
# OAuth Client ID type: Web application.
# Authorized redirect URI for local development:
# http://127.0.0.1:3210/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3210/api/auth/google/callback
